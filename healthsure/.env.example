# HealthSure Environment Variables Configuration Template
# Copy this file to .env and replace placeholder values for your local environment

# Spring Profile (dev / prod / test)
SPRING_PROFILES_ACTIVE=prod

# Server Port
SERVER_PORT=8080
HOST_APP_PORT=8081

# Database Configuration (MySQL 8)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=healthsure
DB_USERNAME=healthsure
DB_PASSWORD=your_secure_db_password_here
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# Seed Data (true for development/evaluation, false for production)
SEED_DATA_ENABLED=true

# Upload Storage Directory
UPLOAD_DIR=/app/uploads

# Container Registry Configuration
DOCKER_REGISTRY=docker.io
DOCKER_NAMESPACE=your_dockerhub_username
DOCKER_HUB_CREDENTIALS_ID=docker-hub-credentials
