# Auto detect text files and perform LF normalization
* text=auto

# Source code files
*.java text diff=java eol=lf
*.html text diff=html eol=lf
*.css text diff=css eol=lf
*.js text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Shell and Jenkins scripts
Jenkinsfile text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
